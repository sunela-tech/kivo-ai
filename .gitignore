# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Generated locally, never committed:
# prepared training sets and downloaded sources
/data/
# checkpoints, metrics, training status
/runs/
# your generated images
/projects/
# the active plan and today's image count
/settings.json
/usage.json

# Installed inference weights stay local, except the small INKOS 1, INKOS 1.1
# and INKOS MOTION 1 exports (about 13 MB each), which are committed so the
# interface works after cloning.
/models/*
!/models/inkos1/
!/models/inkos1_1/
!/models/inkos_motion1/

# packaged downloads (tools/package_python_app.py)
/dist/
