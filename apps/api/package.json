{
  "name": "@kivo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply kivo --local",
    "db:migrate:remote": "wrangler d1 migrations apply kivo --remote"
  },
  "dependencies": {
    "@kivo/shared": "*",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
